#!/usr/bin/env bash
# install: Orchestrator for setting up the environment.
#
# Flow:
#   1. Detect OS.
#   2. Create symlinks (cross-platform).
#   3. Install packages (OS-aware).
#   4. Apply OS-specific settings (only what is supported).
#   5. Run module installers.

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DOTFILES_ROOT

# shellcheck source=lib/utils.sh
source "$DOTFILES_ROOT/lib/utils.sh"

# 1. Detect OS first
OS="$(detect_os)"

echo "🎯 Environment Orchestrator"
echo "   OS: $OS"

case "$OS" in
  macos|wsl|linux)
    info "OS detected: $OS"
    ;;
  *)
    error "Unsupported OS: $OS"
    exit 1
    ;;
esac

# 2. Create symlinks (safe on all platforms)
info "Creating symlinks..."
"$DOTFILES_ROOT/scripts/link-dotfiles"

# 3. Install packages using the OS-appropriate package manager
info "Installing packages..."
"$DOTFILES_ROOT/scripts/install-packages"

# 4. Apply OS-specific settings (only what is supported for the current OS)
if [[ "$OS" == "macos" ]]; then
  info "Applying macOS settings..."
  "$DOTFILES_ROOT/os/setup-macos.sh"
elif [[ "$OS" == "wsl" ]]; then
  warn "WSL setup is not yet implemented. Skipping OS-specific configuration."
else
  warn "Linux setup is not yet implemented. Skipping OS-specific configuration."
fi

# 5. Module setup (auto-discovery)
info "Configuring modules..."
for module_script in "$DOTFILES_ROOT/modules"/*/install.sh; do
  if [[ ! -f "$module_script" ]]; then
    continue
  fi
  module_name="$(basename "$(dirname "$module_script")")"
  module_name_upper="$(echo "$module_name" | tr '[:lower:]' '[:upper:]')"
  echo "   [$module_name_upper] Running installer..."
  bash "$module_script"
done

success "All done! Open a new shell to enjoy your setup."
