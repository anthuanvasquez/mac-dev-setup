#!/usr/bin/env bash
# link-dotfiles: Create symbolic links from dotfiles/home to $HOME

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOME_DIR="$HOME"

# shellcheck source=lib/utils.sh
source "$DOTFILES_ROOT/lib/utils.sh"

info "Linking dotfiles..."

link_file() {
  local src="$1"
  local dst="$2"

  mkdir -p "$(dirname "$dst")"

  if [[ -L "$dst" ]]; then
    local current_target
    current_target="$(readlink "$dst")"
    if [[ "$current_target" == "$src" ]]; then
      info "Already linked: $dst"
    else
      warn "Updating existing link: $dst -> $src"
      rm "$dst"
      ln -s "$src" "$dst"
    fi
  elif [[ -e "$dst" ]]; then
    local backup="$dst.bak.$(date +%Y%m%d%H%M%S)"
    warn "$dst exists. Backing up to $backup"
    mv "$dst" "$backup"
    ln -s "$src" "$dst"
  else
    info "Creating: $dst -> $src"
    ln -s "$src" "$dst"
  fi
}

while IFS= read -r src; do
  rel_path="${src#$DOTFILES_ROOT/home/}"
  dst="$HOME_DIR/$rel_path"
  link_file "$src" "$dst"
done < <(find "$DOTFILES_ROOT/home" -type f -not -name ".DS_Store")

success "Linking complete."
