#!/usr/bin/env bash
# setup: The one-command setup entry point.
# curl -fsSL https://raw.githubusercontent.com/anthuanvasquez/dotfiles/master/setup | bash

set -euo pipefail

REPO_URL="https://github.com/anthuanvasquez/dotfiles.git"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

# 1. Install Xcode Command Line Tools on macOS
if [[ "$OSTYPE" == "darwin"* ]] && ! xcode-select -p &>/dev/null; then
  echo "🛠️  Installing Xcode Command Line Tools..."
  xcode-select --install
fi

# 2. Clone repo if not already there
if [ ! -d "$DOTFILES_DIR" ]; then
  echo "🚀 Cloning dotfiles..."
  git clone "$REPO_URL" "$DOTFILES_DIR"
fi

cd "$DOTFILES_DIR"

# 3. Give execution permissions
echo "🔧 Ensuring executable permissions..."
chmod +x setup install scripts/* os/* bin/* modules/*/install.sh 2>/dev/null || true

# 4. Launch installer
echo "📦 Starting installation..."
./install
